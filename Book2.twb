    <worksheet name='Sheet 6'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>Trend Over Time</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='IN_youtube_trending_data (IN_youtube_trending_data.csv)' name='federated.0e4ieqh1umpic21b91gif02beh9u' />
          </datasources>
          <datasource-dependencies datasource='federated.0e4ieqh1umpic21b91gif02beh9u'>
            <column caption='Total views' datatype='integer' default-format='n#,##0,,,.00B;-#,##0,,,.00B' name='[Calculation_0097307240562688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([view_count])' />
            </column>
            <column caption='Trend over time' datatype='integer' name='[Calculation_0244092415463427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [publishedAt], [trending_date])' />
            </column>
            <column caption='category ' datatype='string' name='[Calculation_0741620789747713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [categoryId]&#13;&#10;   WHEN 1 THEN &quot;Film &amp; Animation&quot;&#13;&#10;   WHEN 2 THEN &quot;Autos &amp; Vehicles&quot;&#13;&#10;   WHEN 10 THEN &quot;Music&quot;&#13;&#10;   WHEN 15 THEN &quot;Pets &amp; Animals&quot;&#13;&#10;   WHEN 17 THEN &quot;Sports&quot;&#13;&#10;   WHEN 19 THEN &quot;Travel &amp; Events&quot;&#13;&#10;   WHEN 20 THEN &quot;Gaming&quot;&#13;&#10;   WHEN 22 THEN &quot;People &amp; Blogs&quot;&#13;&#10;   WHEN 23 THEN &quot;Comedy&quot;&#13;&#10;   WHEN 24 THEN &quot;Entertainment&quot;&#13;&#10;   WHEN 25 THEN &quot;News &amp; Politics&quot;&#13;&#10;   WHEN 26 THEN &quot;Education&quot;&#13;&#10;   WHEN 27 THEN &quot;Science &amp; Technology&quot;&#13;&#10;   WHEN 44 THEN &quot;Trailers&quot;&#13;&#10;   ELSE &quot;Unknown&quot;&#13;&#10;END' />
            </column>
            <column caption='Category Id' datatype='integer' name='[categoryId]' role='dimension' type='ordinal' />
            <column-instance column='[publishedAt]' derivation='Month' name='[mn:publishedAt:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_0741620789747713]' derivation='None' name='[none:Calculation_0741620789747713:nk]' pivot='key' type='nominal' />
            <column caption='Published At' datatype='date' name='[publishedAt]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0244092415463427]' derivation='Sum' name='[sum:Calculation_0244092415463427:qk]' pivot='key' type='quantitative' />
            <column aggregation='CountD' caption='Trending Date' datatype='date' name='[trending_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0097307240562688]' derivation='User' name='[usr:Calculation_0097307240562688:qk]' pivot='key' type='quantitative' />
            <column caption='View Count' datatype='integer' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[view_count]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0e4ieqh1umpic21b91gif02beh9u].[none:Calculation_0741620789747713:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
