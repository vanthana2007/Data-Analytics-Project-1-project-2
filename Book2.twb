      <aliases enabled='yes' />
      <column caption='Total views' datatype='integer' default-format='n#,##0,,,.00B;-#,##0,,,.00B' name='[Calculation_0097307240562688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([view_count])' />
      </column>
      <column caption='Avg Engagement' datatype='real' name='[Calculation_0097307242246145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([likes])/AVG([view_count])' />
      </column>
      <column caption='Total Interaction' datatype='real' default-format='p0.00%' name='[Calculation_0097307243016194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([likes])+ SUM([comment_count]))/ SUM([view_count]))' />
      </column>
      <column caption='Total Views' datatype='integer' default-format='n0,,,.00B;-0,,,.00B' name='[Calculation_0097307244486659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([view_count])' />
      </column>
      <column caption='Top Category' datatype='string' name='[Calculation_0097307246198788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED : MAX([channelTitle])}' />
      </column>
      <column caption='Dislike Ratio' datatype='real' default-format='p0.00%' name='[Calculation_0097307253981194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dislikes]) / SUM([view_count])*100' />
      </column>
      <column caption='week' datatype='datetime' name='[Calculation_0097307256602636]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [trending_date])' />
      </column>
      <column caption='Average Views per Video' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_0097307260059664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([view_count])/ COUNT([video_id])' />
      </column>
      <column caption='over hour' datatype='datetime' datatype-customized='true' name='[Calculation_0097307348086801]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEPARSE ( &quot;HH&quot;, STR(DATEPART(&apos;hour&apos;, [trending_date])) ) ' />
      </column>
      <column caption=' Title' datatype='string' name='[Calculation_0244092394590208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_REPLACE([title], &quot;[^\x00-\x7F]&quot;,&quot;&quot;)' />
      </column>
      <column caption='link icon' datatype='string' name='[Calculation_0244092406231042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;link&quot;' />
      </column>
      <column caption='Trend over time' datatype='integer' name='[Calculation_0244092415463427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [publishedAt], [trending_date])' />
      </column>
      <column caption='category Name' datatype='real' name='[Calculation_0741620789526528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='category ' datatype='string' name='[Calculation_0741620789747713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [categoryId]&#13;&#10;   WHEN 1 THEN &quot;Film &amp; Animation&quot;&#13;&#10;   WHEN 2 THEN &quot;Autos &amp; Vehicles&quot;&#13;&#10;   WHEN 10 THEN &quot;Music&quot;&#13;&#10;   WHEN 15 THEN &quot;Pets &amp; Animals&quot;&#13;&#10;   WHEN 17 THEN &quot;Sports&quot;&#13;&#10;   WHEN 19 THEN &quot;Travel &amp; Events&quot;&#13;&#10;   WHEN 20 THEN &quot;Gaming&quot;&#13;&#10;   WHEN 22 THEN &quot;People &amp; Blogs&quot;&#13;&#10;   WHEN 23 THEN &quot;Comedy&quot;&#13;&#10;   WHEN 24 THEN &quot;Entertainment&quot;&#13;&#10;   WHEN 25 THEN &quot;News &amp; Politics&quot;&#13;&#10;   WHEN 26 THEN &quot;Education&quot;&#13;&#10;   WHEN 27 THEN &quot;Science &amp; Technology&quot;&#13;&#10;   WHEN 44 THEN &quot;Trailers&quot;&#13;&#10;   ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Trending Videos' datatype='integer' name='[Calculation_0741620796243970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([video_id])' />
      </column>
